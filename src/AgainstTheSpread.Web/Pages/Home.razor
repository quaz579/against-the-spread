@page "/"

<PageTitle>Home</PageTitle>

<div class="home-shell">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero__content">
            <span class="eyebrow">College football pick'em</span>
            <h1 id="home-title">Against<br />The Spread</h1>
            <p class="home-hero__lede">Make smarter weekly picks, lock in your card, and take it with you.</p>
            <div class="home-actions">
                <a href="/picks" class="btn btn-primary btn-lg cta-primary">
                    Make weekly picks <span aria-hidden="true">→</span>
                </a>
                <a href="/bowl-picks" class="home-secondary-link">Explore bowl picks <span aria-hidden="true">↗</span></a>
            </div>
        </div>
        <div class="home-hero__mark" aria-hidden="true">🏈</div>
    </section>

    <section class="home-highlights" aria-label="How it works">
        <div class="highlight-card">
            <span class="highlight-card__number">01</span>
            <strong>Choose your week</strong>
            <span>Start with your name and the current season card.</span>
        </div>
        <div class="highlight-card">
            <span class="highlight-card__number">02</span>
            <strong>Pick six teams</strong>
            <span>Tap the side you like in each matchup.</span>
        </div>
        <div class="highlight-card">
            <span class="highlight-card__number">03</span>
            <strong>Download your card</strong>
            <span>Generate an Excel file or print a clean copy.</span>
        </div>
    </section>
</div>